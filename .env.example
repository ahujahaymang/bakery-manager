# ── Database ──────────────────────────────────────────────────────────────────
# Choose "sqlite" (lightweight, single-tenant) or "postgresql" (production)
DB_ENGINE=sqlite

# SQLite — directory where per-tenant .db files are stored (used when DB_ENGINE=sqlite)
# Each tenant gets their own file: <SQLITE_PATH>/<tenant_id>.db
# A shared tenants.db registry file is also created here.
SQLITE_PATH=/data

# PostgreSQL — connection details (used when DB_ENGINE=postgresql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ops_db
DB_USER=postgres
DB_PASSWORD=changeme

# ── Telegram ──────────────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram to get this token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_API_KEY=your-openai-api-key-here
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-nano

# ── S3 backup (SQLite only) ───────────────────────────────────────────────────
# Leave S3_BACKUP_BUCKET blank to disable backups
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=backups
S3_BACKUP_RETAIN_HOURS=24

# ── Admin ─────────────────────────────────────────────────────────────────────
# Your personal Telegram chat_id (message @userinfobot to find it).
# As admin you skip the welcome screen and can operate on any tenant's data.
# Use /switch to list tenants, /switch <chat_id> to switch between them.
ADMIN_CHAT_ID=your-telegram-chat-id-here

# For dedicated single-tenant deployments: set to the owner's chat_id.
# Admin will operate on that tenant directly without the owner needing to
# message first. Leave blank for shared multi-tenant deployments.
OWNER_CHAT_ID=
