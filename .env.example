# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bakery_ops
DB_USER=postgres
DB_PASSWORD=changeme

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# LLM
LLM_API_KEY=your-llm-api-key-here
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# App
APP_ENV=development
WEBHOOK_URL=https://your-domain.com/webhook

# Admin — your personal Telegram chat_id (message @userinfobot to find it)
# This account skips the welcome screen and can operate on any bakery's data
# Use /switch to list bakeries, /switch <chat_id> to switch between them
ADMIN_CHAT_ID=your-telegram-chat-id-here

# For dedicated per-bakery deployments: set to the bakery owner's chat_id.
# Admin will operate on that tenant directly without the owner needing to message first.
# Leave blank for shared-bot deployments.
BAKERY_OWNER_CHAT_ID=

# SQLite (used when DB_ENGINE=sqlite)
DB_ENGINE=sqlite
SQLITE_PATH=/data/bakery.db

# S3 backup (SQLite only — leave blank to disable)
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=backups
S3_BACKUP_RETAIN_HOURS=24
